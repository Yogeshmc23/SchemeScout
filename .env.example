# Copy to .env at the repository root. Never commit real credentials.
DATABASE_URL=postgresql://schemeradar:change-me@localhost:5432/schemeradar
POSTGRES_PASSWORD=change-me
TINYFISH_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
FRONTEND_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT=90
MAX_CONCURRENT_WORKFLOWS=2
# Docker Compose only; API URL used inside containers:
COMPOSE_DATABASE_URL=postgresql://schemeradar:change-me@db:5432/schemeradar
# Backend destination for the Next.js server, NOT the browser:
BACKEND_URL=http://127.0.0.1:8000
# Optional dedicated database for integration tests (never use production):
# TEST_DATABASE_URL=postgresql://schemeradar:change-me@localhost:5432/schemeradar_test
# Test-only: enable real frontend-to-backend HTTP tests after both servers start.
# SCHEMERADAR_SMOKE_URL=http://127.0.0.1:3000

# Opt-in, deployment-wide saved research. Never submit personal data in queries.
ENABLE_RESEARCH_HISTORY=false
